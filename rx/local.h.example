// Copy this file to local.h (gitignored) and fill in real values.

#pragma once

#define WIFI_SSID     "PicoNet"
#define WIFI_PASSWORD "yonoquierovolar"

// Hit once, the first time WiFi comes up after boot — lets a human watching
// the monitoring server's logs confirm the receiver is alive.
#define STARTUP_LOG_URL "http://192.168.1.12/log/door/gate/listening"

// Placeholders, in order: seq (%lu), txno (%u).
#define DOOR_OPEN_URL_TEMPLATE     "http://192.168.1.12/notify/door/gate/open?seq=%lu&txno=%u"
#define DOOR_CLOSE_URL_TEMPLATE    "http://192.168.1.12/notify/door/gate/close?seq=%lu&txno=%u"
#define HEARTBEAT_LOG_URL_TEMPLATE "http://192.168.1.12/log/door/gate/heartbeat?seq=%lu&txno=%u"

// Door held open past either SHORT_OPEN_THRESHOLD_SECONDS (our own check)
// or TX_HELD_OPEN_SECONDS (the transmitter's) — the one placeholder (%u) is
// that threshold, as the URL's last path component.
#define DOOR_OPEN_PAST_URL_TEMPLATE "http://192.168.1.12/log/door/gate/open_past/%u"

// Raised when nothing's been heard from the transmitter in
// STALE_WINDOW_SECONDS. Placeholder (%lu) is how long it's actually been,
// which can run past the threshold by up to one HOUSEKEEPING_INTERVAL_MS.
#define TRANSMISSION_STALE_URL_TEMPLATE "http://192.168.1.12/log/door/gate/transmission_stale?seconds=%lu"

// Raised on PKT_DIAGNOSTIC — the transmitter reporting an abnormal
// boot/reset reason (see PLAN.md's "Reset diagnostics"). Placeholders, in
// order: reason name (%s, from reset_reason_name()), raw reset-reason code
// (%u), seq (%lu), txno (%u).
#define DIAGNOSTIC_URL_TEMPLATE "http://192.168.1.12/log/door/gate/diagnostic/%s?code=%u&seq=%lu&txno=%u"
